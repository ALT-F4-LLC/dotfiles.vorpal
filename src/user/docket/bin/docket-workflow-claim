#!/bin/sh
# docket-workflow-claim — claims one Docket step for docket-workflow.js and hands its work packet
# back as a module the wave loads byte for byte.
#
# WHY IT EXISTS. A Workflow script can neither read a file nor run a command,
# so docket-workflow.js cannot fetch a packet itself, and every channel an agent reads
# through is capped below a packet's size (a Bash result past 128,000
# characters, a hook's additionalContext past 10,000, a Read past its token
# limit). The one uncapped channel is the spawn prompt. A claim agent runs
# this script; it claims the step and writes the packet into a JS module under
# the session's working directory; docket-workflow.js loads that module through a nested
# workflow({scriptPath}) and spawns the executor with the packet inline. The
# harness reads the module from disk, so the executor's prompt carries the
# module's bytes and no model ever copies them.
#
# CONTRACT
#
#   argv    --step STEP-N --owner wave:STEP-N:K --attempt A
#           --module <abs>/.claude/docket-packets/STEP-N.aA.js
#           --metadata '<JSON object>'
#           A is the attempt this claim is expected to take: the dispatch
#           row's `attempt` plus one. Every successful claim increments the
#           step's attempt in the same statement that takes the lease
#           (docket internal/db/leases.go claimTx), so a module named for
#           attempt A can only have been written after the dispatch that
#           named A. That is what keeps a module left over from an earlier
#           wave from passing for this one.
#
#   files   $TMPDIR/STEP-N.d/                  private step dir, mode 0700
#           $TMPDIR/STEP-N.d/STEP-N.token      the lease token, mode 0600
#           $TMPDIR/STEP-N.d/STEP-N.packet.md  the packet, for the record
#           $TMPDIR/STEP-N.d/STEP-N.secret     the recovery secret, mode 0600
#           The recovery secret is made before the first claim (32 random
#           bytes from /dev/urandom, hex) and reused, byte for byte, by every
#           later run for the step; `docket step claim` reads it on stdin,
#           stores its hash on a fresh lease, and re-mints a lease only for
#           the same secret. An existing secret that is not a non-empty
#           regular file the caller owns at mode 0600 is refused before any
#           claim. The secret never enters argv, the environment, the module
#           or stdout.
#           The claim lands in a private work dir first, and the step dir
#           and module are rebuilt only once the lease is this run's: a
#           CONFLICT leaves the holder's token and module untouched. The
#           rebuild clears every file in the step dir but the secret.
#           The module, written atomically: a pure-literal meta, then
#           `return {v, step, owner, attempt, expected_attempt, re_minted,
#           lease_expires_ms, dir, dir_physical, token, packet_file,
#           packet_sha256, packet_abridged, packet_by_reference, packet}`. `dir_physical` is `dir`
#           with every symlink resolved (`pwd -P`). `token` is the token
#           FILE's path; the token itself never enters the module, stdout, or
#           argv.
#           THE SCRIPT CAP. The Workflow tool refuses a script file over
#           524,288 bytes, and the engine keeps up to 262,144 bytes of each
#           gate's output, so a packet with two long gate-results rows cannot
#           load. `packet` is the engine's render byte for byte whenever its
#           module fits. When it would not, each `== INPUT gate-results` row
#           whose `output` is over its budget (8,192 characters on a passing
#           gate, 65,536 on any other) keeps the head and tail of that output
#           around a line naming the cut, and `packet_abridged` is true.
#           When the module still would not fit, `packet` is a short
#           by-reference packet naming `packet_file` and its sha256 for the
#           executor to read, and `packet_by_reference` and `packet_abridged`
#           are both true.
#           `packet_file` and `packet_sha256` are always the engine's render.
#           The written module is measured once more, and one still over the
#           cap is CLAIM INCOMPLETE.
#           The module directory carries a `.gitignore` of `*`, so neither it
#           nor the modules in it ever show in `git status`. Modules older
#           than a day are swept on each run: a lease lives hours at most, so
#           those packets belong to steps long since recorded or reaped.
#
#   stdout  ONE outcome, nothing else:
#             CLAIMED STEP-N attempt=A packet_bytes=B module_bytes=M
#               abridged=0|1 sha256=H module=PATH                (one line)
#             STEP-N / CONFLICT / <the engine's error line>   (three lines)
#             CLAIM FAILED: STEP-N: <why>
#             CLAIM INCOMPLETE: STEP-N: <why>; <how the lease ended>
#           packet_bytes and sha256 describe the engine's render at
#           packet_file; module_bytes is the module on disk.
#
#   exit    0 claimed, 1 claim failed, 2 usage, 4 conflict, 5 incomplete.
#
# A claim whose later stage failed (`claim_error`, docket internal/cli/step.go
# claimStepResponse), or whose written module is over the script cap, holds a
# live lease; this script ends it with `docket step fail` and keeps the step
# dir only when that fail itself errors, so the token stays recoverable.

set -eu
umask 077

me="docket-workflow-claim"

usage() {
	printf '%s USAGE: %s\n' "$me" "$*"
	printf 'usage: %s --step STEP-N --owner wave:STEP-N:K --attempt A --module PATH --metadata JSON\n' "$me"
	exit 2
}

step="" owner="" attempt="" module="" metadata=""
while [ "$#" -gt 0 ]; do
	case "$1" in
	--step | --owner | --attempt | --module | --metadata)
		[ "$#" -ge 2 ] || usage "$1 needs a value"
		case "$1" in
		--step) step="$2" ;;
		--owner) owner="$2" ;;
		--attempt) attempt="$2" ;;
		--module) module="$2" ;;
		--metadata) metadata="$2" ;;
		esac
		shift 2
		;;
	--help | -h) usage "help requested" ;;
	*) usage "unknown argument $1" ;;
	esac
done

digits_only() {
	[ -n "$1" ] && [ -z "$(printf '%s' "$1" | tr -d 0-9)" ]
}

digits_only "${step#STEP-}" && [ "${step#STEP-}" != "$step" ] ||
	usage "--step must be STEP-N, got '$step'"
case "$owner" in
"wave:$step:"*) digits_only "${owner#"wave:$step:"}" || usage "--owner must be wave:$step:K, got '$owner'" ;;
*) usage "--owner must be wave:$step:K, got '$owner'" ;;
esac
digits_only "$attempt" && [ "$attempt" -gt 0 ] ||
	usage "--attempt must be a positive integer, got '$attempt'"
case "$module" in
/*/.claude/docket-packets/"$step.a$attempt.js") ;;
*) usage "--module must be <abs>/.claude/docket-packets/$step.a$attempt.js, got '$module'" ;;
esac

command -v jq >/dev/null 2>&1 || { echo "CLAIM FAILED: $step: jq is not on PATH"; exit 1; }
command -v docket >/dev/null 2>&1 || { echo "CLAIM FAILED: $step: docket is not on PATH"; exit 1; }
printf '%s' "$metadata" | jq -e 'type == "object"' >/dev/null 2>&1 ||
	usage "--metadata must be a JSON object"

tmp="${TMPDIR:-}"
[ -n "$tmp" ] || { echo "CLAIM FAILED: $step: TMPDIR is unset"; exit 1; }
tmp="${tmp%/}"
dir="$tmp/$step.d"
token="$dir/$step.token"
secret="$dir/$step.secret"
packet="$dir/$step.packet.md"
pkdir="${module%/*}"
partial="$module.partial"

sha256() {
	if command -v sha256sum >/dev/null 2>&1; then
		sha256sum "$1" | cut -d' ' -f1
	else
		shasum -a 256 "$1" | cut -d' ' -f1
	fi
}

# The Workflow tool refuses a script file over $cap bytes, and the module is
# one. $wrap covers what the module adds around the packet's JSON string: the
# meta line and the other fields.
cap=524288
wrap=4096
# What an abridged gate row keeps of its `output`, in characters.
keep_pass=8192
keep_fail=65536

# module_estimate <packet file>: the module's size in bytes, within $wrap.
module_estimate() {
	echo $(($(jq -Rs . "$1" | wc -c) + wrap))
}

# fit <in> <out>: <out> is <in> byte for byte when its module fits the cap.
# Otherwise each `== INPUT gate-results` row whose `output` is longer than its
# budget keeps that output's head and tail around a line naming the cut and
# the file holding the engine's render. When the module still does not fit,
# <out> is a short by-reference packet that names the engine's render and its
# sha256, and the executor reads the packet from that file. Sets $abridged and
# $by_reference.
fit() {
	abridged=0
	by_reference=0
	cp "$1" "$2"
	[ "$(module_estimate "$1")" -gt "$cap" ] || return 0
	jq -Rsj --arg file "$packet" --argjson pass "$keep_pass" --argjson fail "$keep_fail" '
		def abridge($keep):
			if (.output | type) == "string" and (.output | length) > $keep then
				(.output | length) as $n | ($keep / 4 | floor) as $head
				| .output = .output[:$head]
					+ "\n[docket-workflow-claim: \($n - $keep) of \($n) characters omitted here to fit the Workflow script cap; the unabridged packet is \($file)]\n"
					+ .output[-($keep - $head):]
			else . end;
		def rows:
			try (fromjson
				| if type == "array" then
					map(if type == "object" then abridge(if .verdict == "pass" then $pass else $fail end) else . end)
					| tojson
				else null end)
			catch null;
		split("\n") as $l
		| [range(0; $l | length) as $i
			| if $i > 0 and ($l[$i - 1] | startswith("== INPUT gate-results from "))
				then ($l[$i] | rows) // $l[$i]
				else $l[$i] end]
		| join("\n")' "$1" >"$2.fit" 2>/dev/null || :
	if [ -s "$2.fit" ] && ! cmp -s "$1" "$2.fit"; then
		mv -f "$2.fit" "$2"
		abridged=1
	fi
	rm -f "$2.fit"
	[ "$(module_estimate "$2")" -gt "$cap" ] || return 0
	# A Read cuts a line past about 2,000 characters and a gate row is one
	# line, so the executor reads a copy folded at 1,500 bytes.
	folded="$dir/$step.packet.folded.md"
	fold -b -w 1500 "$1" >"$folded"
	printf '== STEP %s (by reference)\nThis packet is %s bytes, too large to carry inline under the Workflow script cap.\nThe engine'\''s render is the file %s, sha256 %s.\nRead %s in full, in sections with offset and limit, before any other work, and treat it as this packet. That copy has a line break every 1,500 bytes and is otherwise the same bytes.\n' \
		"$step" "$(wc -c <"$1" | tr -d ' ')" "$packet" "$(sha256 "$1")" "$folded" >"$2"
	abridged=1
	by_reference=1
}

# end_lease <why>: ends this run's live lease with `docket step fail` and
# exits 5. The step dir is kept only when that fail itself errors, so the
# token stays recoverable.
end_lease() {
	if fail_out="$(docket step fail "$step" --note "$1" <"$token" 2>&1)"; then
		rm -rf "$dir"
		printf 'CLAIM INCOMPLETE: %s: %s; the lease was ended with docket step fail\n' "$step" "$1"
	else
		printf 'CLAIM INCOMPLETE: %s: %s; docket step fail errored (%s), so the token is kept at %s\n' \
			"$step" "$1" "$(printf '%s' "$fail_out" | head -n 1)" "$token"
	fi
	exit 5
}

mkdir -p "$pkdir"
[ -f "$pkdir/.gitignore" ] || printf '*\n' >"$pkdir/.gitignore"
find "$pkdir" -maxdepth 1 -type f \( -name 'STEP-*.js' -o -name 'rows-*.js' \) -mmin +1440 -exec rm -f {} + 2>/dev/null || :

# The claim lands in a private work dir first. The step dir and the module
# are replaced only once this run holds the lease: a refused claim means
# another owner holds it, and its token file is not this run's to remove.
work="$(mktemp -d "$tmp/$step.claim.XXXXXX")" ||
	{ echo "CLAIM FAILED: $step: cannot create a work dir under $tmp"; exit 1; }
claim="$work/claim.json"
claim_err="$work/claim.err"
# The claim response carries the token: the work dir goes whatever path this
# script exits by.
trap 'rm -rf "$work" "$partial"' EXIT

uid="$(id -u)"
mkdir -m 700 "$dir" 2>/dev/null || :
[ -n "$(find "$dir" -prune -type d -user "$uid" 2>/dev/null)" ] ||
	{ echo "CLAIM FAILED: $step: $dir is not a directory you own"; exit 1; }
# A fresh secret is written whole in the work dir, then hard-linked into
# place: the link never clobbers, so a concurrent run's secret wins intact and
# no partial secret is ever visible at $secret. The work dir's link goes with
# the EXIT trap.
if [ ! -e "$secret" ] && [ ! -L "$secret" ]; then
	od -An -N32 -tx1 /dev/urandom | tr -d ' \n' >"$work/secret"
	[ "$(wc -c <"$work/secret" | tr -d ' ')" -eq 64 ] ||
		{ echo "CLAIM FAILED: $step: cannot read 32 random bytes from /dev/urandom"; exit 1; }
	ln "$work/secret" "$secret" 2>/dev/null || :
fi
[ -n "$(find "$secret" -prune -type f -user "$uid" -perm 600 ! -empty 2>/dev/null)" ] ||
	{ echo "CLAIM FAILED: $step: $secret must be a non-empty regular file you own at mode 0600"; exit 1; }

rc=0
docket step claim "$step" --owner "$owner" --render --metadata "$metadata" --json=v2 \
	>"$claim" 2>"$claim_err" <"$secret" || rc=$?

jq -r '.data.token // empty' "$claim" >"$work/token" 2>/dev/null || :
if [ ! -s "$work/token" ]; then
	err="$(jq -r '.error // empty' "$claim" 2>/dev/null || :)"
	code="$(jq -r '.code // empty' "$claim" 2>/dev/null || :)"
	[ -n "$err" ] || err="$(head -n 1 "$claim_err" 2>/dev/null || :)"
	if [ "$code" = "CONFLICT" ]; then
		printf '%s\nCONFLICT\n%s\n' "$step" "$err"
		exit 4
	fi
	printf 'CLAIM FAILED: %s: %s\n' "$step" "${err:-docket step claim exited $rc and printed no token}"
	exit 1
fi

# This run holds the lease (fresh, or re-minted under the same owner).
rm -f "$module"
find "$dir" -mindepth 1 -maxdepth 1 ! -name "$step.secret" -exec rm -rf {} +
chmod 700 "$dir"
mv "$work/token" "$token"
chmod 600 "$token"
# The step dir with every symlink resolved: under a sandbox the Write tool
# lands at this physical path, not at $TMPDIR's spelling of it.
dir_physical="$(cd "$dir" && pwd -P)" || {
	printf 'CLAIM FAILED: %s: cannot resolve the physical path of %s; the token is kept at %s for a reap\n' "$step" "$dir" "$token"
	exit 1
}

claim_error="$(jq -r '.data.claim_error // empty' "$claim")"
[ -z "$claim_error" ] || end_lease "$claim_error"

got="$(jq -r '.data.attempt // empty' "$claim")"
jq -j '.data.packet // ""' "$claim" >"$packet"
if [ ! -s "$packet" ]; then
	printf 'CLAIM FAILED: %s: the claim committed but carried no packet; the token is kept at %s for a reap\n' "$step" "$token"
	exit 1
fi
digest="$(sha256 "$packet")"
bytes="$(wc -c <"$packet" | tr -d ' ')"
fit "$packet" "$work/packet.fit"

{
	printf "export const meta = { name: 'docket-packet', description: 'Docket work packet written by docket-workflow-claim' }\n"
	printf 'return '
	jq -c \
		--arg step "$step" --arg owner "$owner" --argjson expected "$attempt" \
		--arg dir "$dir" --arg dir_physical "$dir_physical" --arg token "$token" \
		--arg packet_file "$packet" --arg sha "$digest" \
		--rawfile packet "$work/packet.fit" --argjson abridged "$abridged" \
		--argjson by_reference "$by_reference" \
		'{v: 1, step: $step, owner: $owner, attempt: .data.attempt,
		  expected_attempt: $expected, re_minted: (.data.re_minted // false),
		  lease_expires_ms: .data.lease_expires_ms, dir: $dir,
		  dir_physical: $dir_physical, token: $token,
		  packet_file: $packet_file, packet_sha256: $sha,
		  packet_abridged: ($abridged == 1),
		  packet_by_reference: ($by_reference == 1), packet: $packet}' \
		"$claim"
} >"$partial"
module_bytes="$(wc -c <"$partial" | tr -d ' ')"
if [ "$module_bytes" -gt "$cap" ]; then
	rm -f "$partial"
	end_lease "the packet module is $module_bytes bytes, over the Workflow script cap of $cap bytes, with gate output abridged"
fi
mv -f "$partial" "$module"

printf 'CLAIMED %s attempt=%s packet_bytes=%s module_bytes=%s abridged=%s sha256=%s module=%s\n' \
	"$step" "$got" "$bytes" "$module_bytes" "$abridged" "$digest" "$module"
