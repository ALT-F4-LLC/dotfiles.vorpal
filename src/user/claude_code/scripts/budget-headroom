#!/bin/sh
# budget-headroom — read-only. Project a run's remaining declared cost against
# its cap: cap, spend, the summed expected_cost of every step not yet started,
# the headroom, and a one-word verdict (fits / raise-needed). Two reads, no
# writes (`step list`, `run budget` with no --set). Use it instead of reading
# `run activate --dry-run`'s expected_cost_total, which is the WHOLE run's
# roster total (done + skipped + superseded + pending), not the increment —
# misreading it as the increment bought RUN-39 a second raise to 48 it did not
# need (35.1 was the run total; the increment was 2.1). Prints the pending ROW
# COUNT beside the sum so a status the select misses shows as a short count.
# Usage: budget-headroom RUN-39
set -eu
[ $# -eq 1 ] || { echo "usage: budget-headroom RUN-N" >&2; exit 2; }
run=$1
pending=$(docket step list --run "$run" --json | jq '[.data.steps[]
    | select(.status=="pending" or .status=="ready" or .status=="gated")]
    | {n: length, sum: (map(.expected_cost) | add // 0)}')
docket run budget "$run" --json | jq -r --argjson p "$pending" '
    .data as $b
    | ($b.budget - $b.spend) as $head
    | "run:          \($b.run // "'"$run"'")",
      "cap:          \($b.budget)",
      "spend:        \($b.spend)",
      "pending sum:  \($p.sum)   (\($p.n) step row(s))",
      "headroom:     \($head)",
      "verdict:      \(if $p.sum <= $head then "fits" else "raise-needed" end)"'
