{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "research-notes@3",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "properties": {
      "answer": {
        "type": "string",
        "minLength": 1
      },
      "evidence": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "claim": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "enum": [
                "quoted",
                "summary-derived",
                "repository",
                "inference"
              ]
            },
            "quotation": {
              "type": "string"
            },
            "provenance": {
              "type": "string"
            },
            "supports": {
              "type": "string"
            }
          },
          "required": [
            "claim",
            "label"
          ],
          "additionalProperties": true
        }
      },
      "recommendation": {
        "type": "string"
      },
      "coverage": {
        "type": "string"
      },
      "open_questions": {
        "type": "string"
      }
    },
    "required": [
      "answer",
      "evidence"
    ],
    "additionalProperties": true
  }
}
