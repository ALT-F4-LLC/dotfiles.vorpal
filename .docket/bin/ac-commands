#!/usr/bin/env bash
#
# ac-commands — run the repo's corpus-wide checks and print their results for
# the verifier.
#
# Wired as a PRE-GATE on `verify`
# (src/user/docket/config/workflows/standard-change.toml): it runs at claim, and
# its output lands in the step's context bundle. That is the whole point.
# `verify-ac` judges acceptance criteria against the diff, and an AC that
# depends on a command's result is one it cannot settle by reading code —
# without recorded command results it must return `unverifiable`, which parks
# the step on the operator.
#
# It reports rather than judges: it prints what ran and what each exited, and
# ALWAYS EXITS 0. A failing check is evidence the verifier should see and weigh,
# not a reason to refuse the claim.
#
# Covers two commands: `crossref-check` and `doc-validate`. Both are
# corpus-wide gates with no other source of execution evidence, so an AC that
# depends on them would otherwise come back `unverifiable`.
#
# It does NOT run `build` or `tests`. Those are the gates that fail a write step
# (`implement` and `fix`). Their evidence reaches verify-ac through
# `implement.gate-results`, which the engine (116f13a, installed in nightly
# 0661f86) rebinds to the latest fix round. Running them here again cannot
# finish inside the claim's pre-gate budget, which kills the gate before it
# reports anything.
#
# It deliberately does NOT read or execute any commands from an issue body's
# fenced code blocks — doing so would require an operator trust decision that
# has not been made, so this script only ever runs the fixed commands above.

set -euo pipefail

# Anchored to this script's own repository rather than the caller's cwd: the
# commands below check whatever tree they are run in, so a hand-run from
# elsewhere must not report on a different checkout as if it were this one.
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
if ! repo_root="$(git -C "$script_dir" rev-parse --show-toplevel 2>/dev/null)"; then
  echo "ac-commands: $script_dir is not inside a git repository; nothing to report" >&2
  exit 0
fi
cd "$repo_root"

work="$(mktemp -d "${TMPDIR:-/tmp}/ac-commands.XXXXXX")"
trap 'rm -rf "$work"' EXIT

run() {
  local label="$1" out="${work}/${1}.out" rc=0; shift
  echo "--- $label: $* ---"
  "$@" > "$out" 2>&1 || rc=$?
  tail -20 "$out"
  echo "[$label] exit $rc"
  echo
}

echo "=== ac-commands: recorded results for the verifier ==="
echo "commit: $(git rev-parse --short HEAD)"
echo "tree:   $(git status --porcelain | wc -l | tr -d ' ') uncommitted path(s)"
echo

# `just` rather than the underlying scripts: the justfile is where each
# command's invocation is defined, and the `doc-validate` gate runs that same
# recipe. Naming the recipe keeps the verifier's evidence and the gate's
# verdict describing one command, not two that drift.
run crossref-check just crossref-check
run doc-validate just doc-validate

echo "=== end ac-commands ==="
exit 0
