#!/usr/bin/env python3
"""wave-usage <wave-transcript-dir> — emit backfill rows JSON for a completed wave.

THE TRANSCRIPT-DERIVED TOKEN PATH, and a designed one rather than a workaround:
a claimant cannot observe its own token consumption, so the relay that spawned
it measures the transcripts here and pipes the result to `docket dispatch
backfill-usage --from-json -`. The engine's at-source channel, `docket step
record --usage`, covers the different case — units a claimant CAN measure.

Joins each agent-<id>.jsonl's usage to its step id (named in the agent's first
user message — the bootstrap prompt) and sums the four typed units per step.
Usage entries are deduplicated BY MESSAGE ID before summing: streamed assistant
messages repeat across transcript lines, and a per-line sum double-counts
(measured 1.65-2.36x on RUN-2 before the dedup).

DEDUP TAKES THE LAST OCCURRENCE OF A MESSAGE ID, NOT THE FIRST, and that
direction is load-bearing — do not "simplify" it back to a seen-set. Streaming
rewrites one message id across many lines and `output_tokens` GROWS with each
rewrite, so the first occurrence is a PARTIAL count. Taking the first
under-reported output ~3x (measured on RUN-7 STEP-319: 4,488 recorded against
14,691 actual) while input and both cache units, which never change across
occurrences, matched exactly — which is why it went unnoticed. The original
double-count this dedup was written to fix was driven by those cache units
(cache_read per-line 3,823,178 vs 2,231,212 true, 1.71x, right in the band
above); output_tokens per-line was already within ~1% of correct. So the two
failure modes pull in opposite directions and last-wins is what satisfies both.

`--exclude STEP-N` (repeatable) drops a step whose usage a PRIOR dispatch's
backfill already carries — a gate probed in one wave and seated in the next
emits usage in both journals, and the engine's append-only refusal is
per-batch, not per-row.

Deterministic, read-only, stdout-only. Exit 1 if any agent's step cannot be
attributed or a dispatched agent carries no usage — silence must not look like
success.
"""
import json, os, re, sys

UNITS = {
    "input_tokens": "input_tokens",
    "output_tokens": "output_tokens",
    "cache_creation_input_tokens": "cache_creation_tokens",
    "cache_read_input_tokens": "cache_read_tokens",
}

def main() -> int:
    argv = sys.argv[1:]
    exclude: set[str] = set()
    while "--exclude" in argv:
        i = argv.index("--exclude")
        if i + 1 >= len(argv):
            print("usage: wave-usage [--exclude STEP-N]... <wave-transcript-dir>", file=sys.stderr)
            return 2
        exclude.add(argv[i + 1])
        del argv[i:i + 2]
    if len(argv) != 1 or not os.path.isdir(argv[0]):
        print("usage: wave-usage [--exclude STEP-N]... <wave-transcript-dir>", file=sys.stderr)
        return 2
    d = argv[0]
    totals: dict[str, dict[str, int]] = {}
    errors: list[str] = []
    for name in sorted(os.listdir(d)):
        if not (name.startswith("agent-") and name.endswith(".jsonl")):
            continue
        path = os.path.join(d, name)
        step = None
        per_msg: dict[str, dict] = {}
        with open(path, encoding="utf-8") as f:
            for line in f:
                try:
                    obj = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if step is None and obj.get("type") == "user":
                    content = obj.get("message", {}).get("content")
                    text = content if isinstance(content, str) else json.dumps(content)
                    m = re.search(r"STEP-\d+", text or "")
                    if m:
                        step = m.group(0)
                if obj.get("type") == "assistant":
                    msg = obj.get("message", {})
                    usage = msg.get("usage")
                    mid = msg.get("id")
                    if not usage or not mid:
                        continue
                    per_msg[mid] = usage  # last write wins — see module docstring
        agent_sums = {u: 0 for u in UNITS.values()}
        for usage in per_msg.values():
            for src, dst in UNITS.items():
                agent_sums[dst] += int(usage.get(src) or 0)
        if step is None:
            errors.append(f"{name}: no STEP-N found in first user message")
            continue
        if step in exclude:
            continue  # a prior dispatch's backfill already carries this step
        if not any(agent_sums.values()):
            errors.append(f"{name} ({step}): transcript carries no usage")
            continue
        t = totals.setdefault(step, {u: 0 for u in UNITS.values()})
        for u, q in agent_sums.items():
            t[u] += q
    if errors:
        for e in errors:
            print(f"wave-usage: {e}", file=sys.stderr)
        return 1
    rows = [
        {"step": step, "unit": unit, "quantity": qty}
        for step in sorted(totals, key=lambda s: int(s.split("-")[1]))
        for unit, qty in totals[step].items()
    ]
    json.dump(rows, sys.stdout, indent=2)
    print()
    return 0

if __name__ == "__main__":
    sys.exit(main())
