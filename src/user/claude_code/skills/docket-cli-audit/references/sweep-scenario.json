        ".docket/config/workflows/sweep-dev.toml": "[pipeline]\nname = \"sweep-dev\"\nversion = 1\ndescription = \"Sweep: one worker step, then a person approves.\"\n\n[match]\nlabels_all = [\"sweep-dev\"]\n\n[[step]]\nname = \"check\"\nafter = []\nexecutor = \"prober\"\nemits = \"check-report\"\non_fail = \"fix-loop\"\n\n[[step]]\nname = \"approve\"\nafter = [\"check\"]\ntype = \"human\"\non_fail = \"fix-loop\"\n\n[[step]]\nname = \"fix\"\nexecutor = \"prober\"\nemits = \"fix-summary\"\nloop = true\nafter_loop = \"check\"\n",
        ".docket/config/workflows/sweep-park.toml": "[pipeline]\nname = \"sweep-park\"\nversion = 1\ndescription = \"Sweep: a check that parks on failure, then a person decides.\"\n\n[match]\nlabels_all = [\"sweep-park\"]\n\n[[step]]\nname = \"check\"\nafter = []\nexecutor = \"prober\"\nemits = \"check-report\"\nmax_attempts = 1\non_fail = \"waiting-human\"\n\n[[step]]\nname = \"approve\"\nafter = [\"check\"]\ntype = \"human\"\non_fail = \"abandon-issue\"\n"
