#!/usr/bin/env bash
#
# crossref-check — every name the prose corpus points at still exists.
#
# The corpus is the Claude Code skill tree (src/user/claude_code: CLAUDE.md,
# skills/**/*.md, agents/*.md) and the docket definition tree
# (src/user/docket/config: contracts, fragments, workflows, policy.toml,
# README.md). The two trees name each other constantly — a skill cites a
# contract path, a workflow comment cites a schema version, a contract cites
# a gate — and a rename on one side leaves the other side describing a thing
# that is gone. Nothing else reads both trees: doc-validate checks a header
# on changed files, contract-includes resolves packet_includes only,
# frozen-drift-check compares bytes to the registry. This gate resolves the
# references themselves, over the WHOLE corpus every run, because the file
# that breaks is usually not the file that changed.
#
# Checks, each deterministic and each named in the failure line:
#
#   path         A path-shaped token resolves on disk. Repo-rooted forms
#                (src/user/..., .docket/bin/x, tests/x.test.sh) are checked
#                everywhere. Tree-relative forms (skills/x/..., agents/x.md,
#                hooks/x.sh, workflows/x.js) resolve under
#                src/user/claude_code. Bare corpus forms (contracts/x.md,
#                fragments/x.md, schemas/x.json, workflows/x.toml,
#                changelogs/x.md) are checked only inside
#                src/user/docket/config, because the
#                docket skill's engine reference documents another repo's
#                example corpus with the same directory names.
#   link         A relative markdown link resolves beside the file, and a
#                `#fragment` on it names a heading in the target, slugged
#                the way GitHub does (lowercase, punctuation dropped,
#                spaces to hyphens, a repeated slug suffixed -1, -2, ...).
#   skill        A `/docket-<x>` slash reference names an existing skill
#                directory. Other slash references are not checked: some
#                name Claude Code built-ins (/loop) and some are trigger
#                phrases the skill description advertises, and the gate has
#                no way to tell those apart from a typo. A skill's
#                frontmatter description is the hand-off surface, so there
#                every `docket-<x>` token must be a skill directory and a
#                backticked short form of one (`refit` for docket-refit)
#                is refused.
#   schema       A `<name>@<N>` token whose <name> is a schema this corpus
#                ships resolves to schemas/<name>@<N>.json. Older versions
#                stay on disk for pinned-run reproduction, so an older
#                mention resolves as long as the file was kept.
#   executor     Every `executor = "<x>"` in a workflow step has
#                contracts/<x>.md (the spec-author-<axis> family shares
#                contracts/spec-author.md, the one exception README.md
#                documents) and a `[executors]` row in policy.toml.
#   payload      A workflow step's `payload = "<schema>@<N>"` equals the
#                frontmatter `payload:` of every contract the step executes
#                (its executor and each fanout member, resolved as above).
#                A step that executes no contract, or whose contract pins no
#                payload, is not compared: a reconcile step's payload is the
#                engine's aggregate, not a contract's emission.
#   gate         Every gate a workflow names is a justfile recipe. A gate
#                the target project supplies instead of this repo is listed
#                in PROJECT_GATES below, with the workflow that needs it.
#   label        Every `route-<x>` token is one of the three routing labels
#                README.md defines, and every workflow's `[match]
#                unless_labels` carries `blocked` plus the two
#                routed-away labels, as README.md says every workflow must.
#   name         A definition's declared name equals its file stem: `name:`
#                for skills and agents, `node:` for contracts, `fragment:`
#                for fragments.
#   contents     A Contents entry `- [label](#id) — N lines` names an
#                `<a id>` anchor in the same file, and N equals the span
#                from that anchor to the next entry's at the same or a
#                shallower indent (or to end of file).
#   inventory    The docket-run references cover the CLI inventory: a flag
#                table lists every local flag of its verb, step.md's verb
#                table lists every `docket step` command, and every family
#                with a `#### docket <family>` heading is in the
#                engine-conductor family list. Skipped without the inventory.
#   fixtures     The docket skill's lists cover the CLI fixtures: every verb
#                whose no-token refusal fixture says it needs the conductor
#                token is in each conductor-gated list, and every engine
#                config key the fixtures list is a row of the configuration
#                table. Skipped without the fixtures.
#
# What is skipped, and why. src/user/docket/config/changelogs/<name>.md holds
# each workflow's and policy.toml's version history; a renamed path is CORRECT
# history there, so that directory is not scanned. Every TOML line is scanned,
# comments included: the history once rode on the `version =` line as a
# trailing comment block, and a block reintroduced there fails like any other
# stale reference.
#
# Exit 1 on the first class of failure found, after listing every failure;
# 0 when every reference resolves. CORPUS_ROOT overrides the repository root
# under test so tests/crossref-check.test.sh can point this gate at a
# deliberately broken copy under $TMPDIR without touching the checkout.

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
if [ -n "${CORPUS_ROOT:-}" ]; then
  repo_root="$CORPUS_ROOT"
elif ! repo_root="$(git -C "$script_dir" rev-parse --show-toplevel 2>/dev/null)"; then
  echo "crossref-check FAILED: $script_dir is not inside a git repository." >&2
  exit 1
fi
cd "$repo_root"

claude_tree="src/user/claude_code"
docket_tree="src/user/docket/config"

# Gates a workflow names that the TARGET project's justfile provides, not this
# repo's. Add a row here only with the workflow that needs it, so a reader can
# tell a deliberate cross-repo gate from a typo.
PROJECT_GATES="
render-verify ui-change
copy-verify ui-change
"

for d in "$claude_tree" "$docket_tree"; do
  if [ ! -d "$d" ]; then
    echo "crossref-check FAILED: $d is not a directory under $repo_root" >&2
    exit 1
  fi
done

failed=0
fail() {
  # $1 check, $2 file, $3 line, $4 message
  echo "crossref-check: $1  $2:$3  $4" >&2
  failed=1
}

# --- corpus files and their checkable lines ---------------------------------

corpus_files() {
  # Hidden directories are never corpus: a sandboxed session mounts its own
  # `.claude/` scaffolding under whatever directory it runs from, and an
  # unreadable file there must not abort the check.
  # changelogs/ is version history: a renamed path there is the record of
  # what an earlier version pointed at, so it is never scanned.
  find "$claude_tree" "$docket_tree" -name '.*' -prune -o -type f \
    \( -name '*.md' -o -name '*.toml' \) -not -path "$claude_tree/hooks/*" \
    -not -path "$docket_tree/changelogs/*" -print | sort
}

# Emit "file<TAB>line<TAB>text" for every line the checks read: every line
# of every corpus file.
checkable_lines() {
  local f="$1"
  awk -v f="$f" '{ printf "%s\t%d\t%s\n", f, NR, $0 }' "$f"
}

lines_file="$(mktemp "${TMPDIR:-/tmp}/crossref-check.XXXXXX")"
trap 'rm -f "$lines_file"' EXIT
while IFS= read -r f; do
  checkable_lines "$f"
done < <(corpus_files) > "$lines_file"

# tokens <regex>: emit "file<TAB>line<TAB>token" for every match of <regex>
# on a checkable line, one row per match. The pattern travels through the
# environment, not `-v`: awk processes escape sequences in a `-v` value, so
# `\]` and `\(` would reach the matcher as bare `]` and `(`.
tokens() {
  TOKEN_RE="$1" awk -F'\t' '
    BEGIN { re = ENVIRON["TOKEN_RE"] }
    {
      s = $3
      while (match(s, re)) {
        printf "%s\t%s\t%s\n", $1, $2, substr(s, RSTART, RLENGTH)
        s = substr(s, RSTART + RLENGTH)
      }
    }
  ' "$lines_file"
}

# --- path: path-shaped tokens resolve on disk --------------------------------

path_re='(src/user/[a-z_]+/[A-Za-z0-9_./@-]+|\.docket/bin/[a-z-]+|tests/[a-z-]+\.test\.(sh|py)|skills/[a-z-]+/[A-Za-z0-9_./-]+|agents/[a-z-]+\.md|hooks/[a-z-]+\.sh|workflows/[a-z-]+\.(js|toml)|contracts/[a-z-]+\.md|fragments/[a-z-]+\.md|schemas/[a-z0-9@-]+\.json|changelogs/[a-z-]+\.md)'
while IFS=$'\t' read -r file line tok; do
  tok="${tok%%[).,:;\`]}"
  tok="${tok%%[).,:;\`]}"
  case "$tok" in
    src/*|.docket/*|tests/*) target="$tok" ;;
    skills/*|agents/*|hooks/*|workflows/*.js) target="$claude_tree/$tok" ;;
    contracts/*|fragments/*|schemas/*|workflows/*.toml|changelogs/*)
      case "$file" in
        "$docket_tree"/*) target="$docket_tree/$tok" ;;
        *) continue ;;
      esac
      ;;
    *) continue ;;
  esac
  # A workflow's `packet = ["contracts/{executor}.md"]` is a template the
  # engine expands per step; the executor check below resolves it.
  case "$target" in *'{executor}'*) continue ;; esac
  [ -e "$target" ] || fail path "$file" "$line" "$tok does not exist"
done < <(tokens "$path_re")

# --- link: a relative markdown link resolves from the file's directory -------

heading_slugs() {
  # GitHub's heading slugs for $1: fenced code is skipped, the text is
  # lowercased, everything but letters, digits, spaces, hyphens and
  # underscores is dropped, spaces become hyphens, and a repeat gets -N.
  awk '
    /^```/ { fence = !fence; next }
    fence { next }
    /^#{1,6} / {
      t = $0; sub(/^#+[[:space:]]*/, "", t); sub(/[[:space:]]+#*[[:space:]]*$/, "", t)
      t = tolower(t); gsub(/[^a-z0-9 _-]/, "", t); gsub(/ /, "-", t)
      if (t in seen) { seen[t]++; t = t "-" (seen[t] - 1) } else { seen[t] = 1 }
      print t
    }
  ' "$1"
}
while IFS=$'\t' read -r file line tok; do
  target="${tok#\](}"; target="${target%)}"
  anchor=""; case "$target" in *'#'*) anchor="${target#*#}" ;; esac
  target="${target%%#*}"
  case "$target" in http://*|https://*|/*) continue ;; esac
  path="$(dirname "$file")/$target"
  if [ ! -e "$path" ]; then
    fail link "$file" "$line" "link target $target does not exist beside $file"
  elif [ -n "$anchor" ] && [ "${path##*.}" = "md" ]; then
    grep -qx -- "$anchor" < <(heading_slugs "$path") || fail link "$file" "$line" "anchor #$anchor names no heading in $target"
  fi
done < <(tokens '\]\([A-Za-z0-9_./-]+\.(md|toml|json|sh|js)(#[^)]*)?\)')

# --- skill: /docket-<x> names an existing skill directory --------------------

while IFS=$'\t' read -r file line tok; do
  name="${tok##*/docket-}"
  [ -d "$claude_tree/skills/docket-$name" ] || fail skill "$file" "$line" "/docket-$name is not a skill under $claude_tree/skills"
done < <(tokens '(^|[^A-Za-z0-9_./-])/docket-[a-z]+(-[a-z]+)*')

# A description hands off by name: every docket-<x> in it is a skill
# directory, and a backticked short form of a docket- skill is refused.
for f in "$claude_tree"/skills/*/SKILL.md; do
  # The description may be a one-line scalar or a folded block (`>` / `>-`)
  # whose continuation lines are indented; read the whole entry either way.
  desc="$(awk 'NR == 1 && $0 != "---" { exit } NR > 1 && $0 == "---" { exit }
    in_desc && /^[A-Za-z-]+:/ { exit }
    in_desc { sub(/^[[:space:]]+/, ""); printf "%s ", $0; next }
    index($0, "description:") == 1 { sub(/^description:[[:space:]]*/, ""); sub(/^>-?[[:space:]]*/, ""); if (length($0)) printf "%s ", $0; in_desc = 1 }' "$f")"
  [ -n "$desc" ] || continue
  # The listing the harness builds from every description is paid on every
  # turn of every session, and it truncates entries near 1,500 characters,
  # silently dropping whatever trigger phrases sit past the cut. Keep each
  # description a trigger surface, not a manual: at most 1000 characters.
  desc_len=$(printf '%s' "$desc" | sed 's/ *$//' | wc -c | tr -d ' ')
  [ "$desc_len" -le 1000 ] || fail skill "$f" 1 "description is ${desc_len} characters; the listing truncates near 1500 and the ceiling is 1000 — lead with the trigger phrases and move the rest into the body"
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    [ -d "$claude_tree/skills/$name" ] || fail skill "$f" 1 "description names $name, not a skill under $claude_tree/skills"
  done < <(grep -oE '(^|[^A-Za-z0-9_./-])docket-[a-z]+(-[a-z]+)*' <<< "$desc" | grep -oE 'docket-[a-z-]+' | sort -u)
  while IFS= read -r short; do
    [ -n "$short" ] || continue
    [ -d "$claude_tree/skills/$short" ] && continue
    [ -d "$claude_tree/skills/docket-$short" ] && fail skill "$f" 1 "description names \`$short\`; the skill is docket-$short"
  # A bare backtick inside single quotes is literal to bash; the escaped form
  # `\\`` is GNU grep's start-of-buffer anchor, which never matched, so this
  # rule was silent on Linux.
  done < <(grep -oE '`[a-z]+(-[a-z]+)*`' <<< "$desc" | tr -d '`' | sort -u)
done

# --- schema: <name>@<N> resolves to a shipped schema file --------------------

schema_names="$(find "$docket_tree/schemas" -name '*@*.json' | sed -E 's|.*/||; s|@[0-9]+\.json$||' | sort -u | tr '\n' '|' | sed 's/|$//')"
if [ -n "$schema_names" ]; then
  while IFS=$'\t' read -r file line tok; do
    [ -f "$docket_tree/schemas/$tok.json" ] || fail schema "$file" "$line" "$tok has no file at $docket_tree/schemas/$tok.json"
  done < <(tokens "($schema_names)@[0-9]+" | awk -F'\t' '$3 ~ /@[0-9]+$/')
fi

# --- executor: contract file and policy row exist ----------------------------

policy_rows="$(awk '/^\[executors\]/{s=1;next} /^\[/{s=0} s && /^[a-z][a-z0-9-]*[[:space:]]*=/{sub(/[[:space:]]*=.*/,""); print}' "$docket_tree/policy.toml" | sort -u)"
while IFS=$'\t' read -r wf line tok; do
  ex="${tok#executor = \"}"; ex="${ex%\"}"
  case "$ex" in
    spec-author-*) contract="$docket_tree/contracts/spec-author.md" ;;
    *) contract="$docket_tree/contracts/$ex.md" ;;
  esac
  [ -f "$contract" ] || fail executor "$wf" "$line" "executor $ex has no contract at $contract"
  grep -qx "$ex" <<< "$policy_rows" || fail executor "$wf" "$line" "executor $ex has no [executors] row in $docket_tree/policy.toml"
done < <(tokens 'executor = "[a-z0-9-]+"' | awk -F'\t' -v t="$docket_tree/workflows/" 'index($1, t) == 1')

# --- gate: every gate a workflow names is a justfile recipe ------------------

recipes="$(grep -oE '^[a-z][a-z0-9-]*:' justfile 2>/dev/null | tr -d ':' | sort -u)"
gate_names() {
  # Every gate name a workflow file lists. The file is flattened first so a
  # multi-line `gates = [...]` reads as one array; names appear as bare "x"
  # entries or as { name = "x", ... } tables.
  tr '\n' ' ' < "$1" \
    | grep -oE 'gates[[:space:]]*=[[:space:]]*\[[^]]*\]' \
    | grep -oE '"[a-z][a-z0-9-]*"' | tr -d '"' | sort -u
}
for wf in "$docket_tree"/workflows/*.toml; do
  stem="$(basename "$wf" .toml)"
  while IFS= read -r g; do
    [ -n "$g" ] || continue
    grep -qx "$g" <<< "$recipes" && continue
    grep -qE "^$g $stem\$" <<< "$PROJECT_GATES" && continue
    line="$(grep -n -m1 -E "\"$g\"" "$wf" | cut -d: -f1)"
    fail gate "$wf" "${line:-0}" "gate $g is not a justfile recipe and not a PROJECT_GATES row for $stem"
  done < <(gate_names "$wf")
done

# --- label: routing labels are the three README.md defines-------------------

# A label is checked only when the prose quotes it (`route-x` or "route-x");
# an unquoted route-<word> is ordinary English.
while IFS=$'\t' read -r file line tok; do
  tok="${tok#[\`\"]}"; tok="${tok%[\`\"]}"
  case "$tok" in
    route-run|route-direct|route-loop) ;;
    *) fail label "$file" "$line" "$tok is not one of route-run, route-direct, route-loop" ;;
  esac
done < <(tokens '[`"]route-[a-z]+[`"]')

for wf in "$docket_tree"/workflows/*.toml; do
  unless="$(tr '\n' ' ' < "$wf" | grep -oE 'unless_labels[[:space:]]*=[[:space:]]*\[[^]]*\]' | head -1)"
  for want in blocked route-direct route-loop; do
    grep -qE "\"$want\"" <<< "$unless" || fail label "$wf" "$(grep -n -m1 'unless_labels' "$wf" | cut -d: -f1)" "[match] unless_labels lacks \"$want\""
  done
done

# --- name: declared name equals file stem -----------------------------------

frontmatter_field() {
  # $1 file, $2 key: the key's value inside the leading YAML block.
  awk -v key="$2" '
    NR == 1 && $0 != "---" { exit }
    NR > 1 && $0 == "---" { exit }
    NR > 1 && index($0, key ":") == 1 { sub("^" key ":[[:space:]]*", ""); print; exit }
  ' "$1"
}
check_name() {
  # $1 file, $2 key, $3 expected
  local got
  got="$(frontmatter_field "$1" "$2")"
  [ "$got" = "$3" ] || fail name "$1" 1 "$2 is '${got:-<missing>}', expected '$3'"
}
for f in "$claude_tree"/skills/*/SKILL.md; do check_name "$f" name "$(basename "$(dirname "$f")")"; done
# Workflow scripts' meta.description and meta.whenToUse land in the same
# per-session listing; the same ceiling applies to each line.
for f in "$claude_tree"/workflows/*.js; do
  [ -f "$f" ] || continue   # a fixture corpus may ship no workflow scripts
  for key in description whenToUse; do
    line_len=$(awk -v k="$key" 'index($0, "    " k ": ") == 1 || index($0, "  " k ": ") == 1 { print length($0); exit }' "$f")
    [ -n "$line_len" ] || continue
    [ "$line_len" -le 1000 ] || fail workflow "$f" 1 "meta.$key is ${line_len} characters; keep it under 1000 and put the contract in the header comment"
  done
done

for f in "$claude_tree"/agents/*.md; do check_name "$f" name "$(basename "$f" .md)"; done
for f in "$docket_tree"/contracts/*.md; do check_name "$f" node "$(basename "$f" .md)"; done
for f in "$docket_tree"/fragments/*.md; do check_name "$f" fragment "$(basename "$f" .md)"; done

# --- payload: a step's payload equals each executed contract's pin ----------

step_payload_rows() {
  # $1 workflow: "line<TAB>step<TAB>payload<TAB>member" for every [[step]]
  # that declares a payload, one row per contract it executes (its executor
  # and each fanout member). A fanout array may span several lines.
  awk -v OFS='\t' '
    function value(s) { sub(/^[^"]*"/, "", s); sub(/".*$/, "", s); return s }
    function flush(   n, i, m) {
      if (in_step && payload != "") {
        if (executor != "") print payload_line, name, payload, executor
        gsub(/[]["=,]/, " ", fanout)
        n = split(fanout, m, " ")
        for (i = 1; i <= n; i++) print payload_line, name, payload, m[i]
      }
      name = executor = payload = fanout = ""; in_fanout = 0
    }
    /^\[/ { flush(); in_step = ($0 == "[[step]]"); next }
    !in_step { next }
    in_fanout { fanout = fanout " " $0; if (index($0, "]")) in_fanout = 0; next }
    /^name[[:space:]]*=/ { name = value($0) }
    /^executor[[:space:]]*=/ { executor = value($0) }
    /^payload[[:space:]]*=/ { payload = value($0); payload_line = NR }
    /^fanout[[:space:]]*=/ {
      fanout = $0; sub(/^fanout[[:space:]]*=/, "", fanout)
      in_fanout = !index(fanout, "]")
    }
    END { flush() }
  ' "$1"
}
for wf in "$docket_tree"/workflows/*.toml; do
  while IFS=$'\t' read -r line step payload member; do
    case "$member" in
      spec-author-*) contract="$docket_tree/contracts/spec-author.md" ;;
      *) contract="$docket_tree/contracts/$member.md" ;;
    esac
    [ -f "$contract" ] || continue
    pin="$(frontmatter_field "$contract" payload)"
    [ -z "$pin" ] || [ "$pin" = "$payload" ] || fail payload "$wf" "$line" "step $step declares $payload; $contract pins $pin"
  done < <(step_payload_rows "$wf")
done

# --- contents ----------------------------------------------------------------
# A Contents entry `- [label](#id) — N lines` states the span from its
# `<a id="id">` anchor to the anchor of the next entry at the same or a
# shallower indent, or to end of file. Edits shift those spans silently, so
# the stated count is recomputed here rather than trusted.
contents_mismatches() {
  awk '
    FNR == NR {
      if (match($0, /<a id="[^"]+"><\/a>/)) anchor[substr($0, RSTART + 7, RLENGTH - 13)] = FNR
      total = FNR
      next
    }
    /^ *- \[.*\]\(#[^)]+\) — [0-9]+ lines/ {
      n++
      match($0, /^ */); ind[n] = RLENGTH
      match($0, /\(#[^)]+\)/); id[n] = substr($0, RSTART + 2, RLENGTH - 3)
      # Strip to the digits rather than slice by offset: the em dash is one
      # character to gawk in a UTF-8 locale and three bytes to BSD awk.
      match($0, /— [0-9]+ lines/); count = substr($0, RSTART, RLENGTH); gsub(/[^0-9]/, "", count)
      stated[n] = count + 0
      ln[n] = FNR
    }
    END {
      for (i = 1; i <= n; i++) {
        if (!(id[i] in anchor)) { printf "%d\tentry #%s has no <a id> anchor\n", ln[i], id[i]; continue }
        end = total + 1
        for (j = i + 1; j <= n; j++) if (ind[j] <= ind[i] && (id[j] in anchor)) { end = anchor[id[j]]; break }
        if (end - anchor[id[i]] != stated[i])
          printf "%d\t#%s states %d lines; the anchors span %d\n", ln[i], id[i], stated[i], end - anchor[id[i]]
      }
    }
  ' "$1" "$1"
}
while IFS= read -r f; do
  case "$f" in *.md) ;; *) continue ;; esac
  grep -q -- '— [0-9][0-9]* lines' "$f" || continue
  while IFS=$'\t' read -r line msg; do
    fail contents "$f" "$line" "$msg"
  done < <(contents_mismatches "$f")
done < <(corpus_files)

# --- inventory: prose tables cover the CLI inventory -------------------------
# skills/docket/references/cli-inventory.json lists every docket command and
# its local flags. The docket-run references mirror parts of it in prose, and
# a new verb or flag leaves those tables silently short. Three rules, each
# keyed on headings and table headers, never on line numbers:
#   1. under a `#### `docket <family> <verb>`` heading in dispatch.md or
#      step.md, the table headed `| Flag |` names every local flag the
#      inventory lists for that verb (--help excepted);
#   2. the `| Verb |` table in step.md names every `docket step` command;
#   3. every family with a `#### `docket <family>`` heading under
#      skills/docket-run/references is in docket/reference.md's list of
#      engine-conductor families.
# A corpus without the inventory, or without a target file, skips the rule.
inventory="$claude_tree/skills/docket/references/cli-inventory.json"
run_refs="$claude_tree/skills/docket-run/references"
docket_ref="$claude_tree/skills/docket/reference.md"

flag_table_gaps() {
  # $1 markdown file; INV_FLAGS is "docket <family> <verb><TAB><flag>" rows.
  awk '
    BEGIN {
      n = split(ENVIRON["INV_FLAGS"], rows, "\n")
      for (i = 1; i <= n; i++) {
        split(rows[i], p, "\t")
        if (p[1] != "") want[p[1]] = want[p[1]] " " p[2]
      }
    }
    function flush(   s, w, nv, v, i, key, nf, fl, j, re) {
      if (!intab) return
      intab = 0
      if (!match(head, /`docket [a-z]+ [a-z-]+(\|[a-z-]+)*/)) return
      s = substr(head, RSTART + 1, RLENGTH - 1)
      split(s, w, " ")
      nv = split(w[3], v, "|")
      for (i = 1; i <= nv; i++) {
        key = "docket " w[2] " " v[i]
        if (!(key in want)) continue
        nf = split(want[key], fl, " ")
        for (j = 1; j <= nf; j++) {
          if (fl[j] == "") continue
          re = "(^|[^-A-Za-z0-9])" fl[j] "([^-A-Za-z0-9]|$)"
          if (tab !~ re) printf "%d\t%s %s is in the CLI inventory but not in the flag table under this heading\n", hl, key, fl[j]
        }
      }
    }
    /^#+ / { flush(); head = $0; hl = FNR; next }
    /^\| *Flag *\|/ { flush(); intab = 1; tab = ""; next }
    intab && /^\|/ { tab = tab "\n" $0; next }
    { flush() }
    END { flush() }
  ' "$1"
}

step_verb_gaps() {
  # $1 step.md; INV_CMDS is one inventory command per line.
  awk '
    /^\| *Verb *\|/ { intab = 1; next }
    intab && /^\|/ {
      if (match($0, /^\| *`step [a-z-]+(\\\|[a-z-]+)*/)) {
        s = substr($0, RSTART, RLENGTH); sub(/^\| *`step /, "", s); gsub(/\\\|/, " ", s)
        nv = split(s, v, " ")
        for (i = 1; i <= nv; i++) seen["docket step " v[i]] = 1
      }
      next
    }
    { intab = 0 }
    END {
      n = split(ENVIRON["INV_CMDS"], cmds, "\n")
      for (i = 1; i <= n; i++)
        if (cmds[i] ~ /^docket step [a-z-]+$/ && !(cmds[i] in seen))
          printf "%s is in the CLI inventory but not in the verb table\n", cmds[i]
    }
  ' "$1"
}

if [ -f "$inventory" ]; then
  if ! command -v jq >/dev/null 2>&1; then
    echo "crossref-check FAILED: $inventory is present but jq is not installed." >&2
    exit 1
  fi
  INV_FLAGS="$(jq -r '.commands[] | .command as $c | .flags[]? | select(.name != "--help") | "\($c)\t\(.name)"' "$inventory")"
  INV_CMDS="$(jq -r '.commands[].command' "$inventory")"
  export INV_FLAGS INV_CMDS

  for f in "$run_refs/dispatch.md" "$run_refs/step.md"; do
    [ -f "$f" ] || continue
    while IFS=$'\t' read -r line msg; do
      fail inventory "$f" "$line" "$msg"
    done < <(flag_table_gaps "$f")
  done

  if [ -f "$run_refs/step.md" ] && grep -q '^| *Verb *|' "$run_refs/step.md"; then
    while IFS= read -r msg; do
      fail inventory "$run_refs/step.md" 1 "$msg"
    done < <(step_verb_gaps "$run_refs/step.md")
  fi

  if [ -f "$docket_ref" ]; then
    families="$(tr '\n' ' ' < "$docket_ref" | grep -o 'engine-conductor families ([^)]*)' | head -1 | sed 's/^[^(]*(//; s/)$//; s/,/ /g' || true)"
    if [ -n "$families" ]; then
      ref_line="$(grep -n 'engine-conductor families' "$docket_ref" | head -1 | cut -d: -f1)"
      while IFS= read -r fam; do
        [ -n "$fam" ] || continue
        case " $families " in *" $fam "*) ;; *)
          fail inventory "$docket_ref" "$ref_line" "family $fam has a docket-run reference heading but is not in the engine-conductor family list" ;;
        esac
      done < <(grep -rh '^#### `docket [a-z][a-z-]*' "$run_refs" 2>/dev/null | sed 's/^#### `docket \([a-z][a-z-]*\).*/\1/' | sort -u)
    fi
  fi
fi

# --- fixtures: prose lists cover the CLI fixtures ----------------------------
# skills/docket-cli-audit/references/cli-fixtures.json records what the swept
# binary emits. Two lists in the docket skill mirror it, and a new gated verb
# or engine key leaves them silently short:
#   1. every verb whose refusal without the run's token says "<verb> requires
#      it: supply the run's token" is named in each conductor-gated list: the
#      gated row of SKILL.md, the AUTH_ERROR row of transport.md and the
#      bullets after "the conductor-gated verbs read it from" there. A name
#      of the form `<family> <verb>` also matches inside an alternation such
#      as `step approve/reject`. A gated verb the sweep skips has no refusal
#      fixture, so the fixtures cannot require it (step integrate today).
#   2. every key the config-get-all fixture lists is a row of the
#      configuration table in workflows.md.
# Each list is found by a phrase, not a line number. A corpus without the
# fixtures skips both rules.
fixtures="$claude_tree/skills/docket-cli-audit/references/cli-fixtures.json"
skill_md="$claude_tree/skills/docket/SKILL.md"
transport_md="$claude_tree/skills/docket/references/transport.md"
workflows_md="$claude_tree/skills/docket/references/workflows.md"

region() {
  # $1 file, $2 start regex, $3 end regex or "" for the start line alone.
  # Prints "<start line><TAB><region joined on one line>"; nothing if the
  # start is not found.
  REGION_S="$2" REGION_E="$3" awk '
    function out() { printf "%d\t%s\n", start, text; done = 1; exit }
    BEGIN { s = ENVIRON["REGION_S"]; e = ENVIRON["REGION_E"] }
    !on && $0 ~ s { on = 1; start = FNR; text = $0; if (e == "") out(); next }
    on && $0 ~ e { out() }
    on { text = text " " $0 }
    END { if (on && !done) out() }
  ' "$1" | sed 's/  */ /g'
}

gated_name_in() {
  # $1 verb name, $2 text. True when the text names the verb.
  local name="$1" text="$2" fam sub
  case "$name" in
    *" "*" "*|*--*) [[ "$text" == *"$name"* ]] ;;
    *) fam="${name%% *}"; sub="${name#* }"
       [[ "$text" =~ (^|[^a-z-])$fam\ ([a-z-]+/)*$sub(/[a-z-]+)*([^a-z-]|$) ]] ;;
  esac
}

if [ -f "$fixtures" ]; then
  if ! command -v jq >/dev/null 2>&1; then
    echo "crossref-check FAILED: $fixtures is present but jq is not installed." >&2
    exit 1
  fi

  if [ -f "$skill_md" ] && [ -f "$transport_md" ]; then
    gated="$(jq -r '.. | objects | select(.id?) | ((.stderr // "") + " " + (.json?.error? // "")) | scan("and ([a-z][a-z0-9 -]*) requires it: supply the run.s token") | .[0]' "$fixtures" | sort -u)"
    check_gated_list() {
      # $1 file, $2 start regex, $3 end regex or "", $4 first-cell marker or "".
      local file="$1" row line text name
      row="$(region "$file" "$2" "$3")"
      if [ -z "$row" ]; then
        fail fixtures "$file" 1 "cannot find the conductor-gated list (\"$2\")"
        return
      fi
      line="${row%%$'\t'*}"; text="${row#*$'\t'}"
      # SKILL.md's row also carries the no-authority sentence: keep the first cell.
      [ -z "$4" ] || text="${text%%"$4"*}"
      while IFS= read -r name; do
        [ -n "$name" ] || continue
        gated_name_in "$name" "$text" || fail fixtures "$file" "$line" "$name needs the conductor token (CLI fixtures) but is not in this list"
      done <<< "$gated"
    }
    check_gated_list "$skill_md" "Require the run's conductor capability" "" "| Require the run"
    check_gated_list "$transport_md" '^\| `AUTH_ERROR` \|' "" ""
    check_gated_list "$transport_md" "conductor-gated verbs read it from" '^Three `--authority` rules' ""
  fi

  if [ -f "$workflows_md" ]; then
    row="$(region "$workflows_md" '^\| *Key *\| *Type' '^[^|]')"
    if [ -z "$row" ]; then
      fail fixtures "$workflows_md" 1 "cannot find the engine configuration table (\"| Key | Type\")"
    else
      line="${row%%$'\t'*}"; text="${row#*$'\t'}"
      while IFS= read -r key; do
        [ -n "$key" ] || continue
        [[ "$text" == *"| \`$key\` |"* ]] || fail fixtures "$workflows_md" "$line" "config key $key is in the CLI fixtures but not in this table"
      done < <(jq -r '.. | objects | select(.id? == "config-get-all" and .mode? == "json") | .json.data.entries[].key' "$fixtures" | sort -u)
    fi
  fi
fi

# --- ask: an ask of the operator names its channel ---------------------------
# CLAUDE.md's ask rule: the operator is asked only through AskUserQuestion, and
# a subagent returns the question to its caller. A paragraph that tells the
# reader to ask the operator or user must name the question tool or the caller
# in the same paragraph, or negate the ask ("never ask", "does not ask").
ask_misses() {
  awk '
    function flush(   low) {
      low = tolower(para)
      if (hit && low !~ /askuserquestion|question tool|question-tool|caller|(never|not|nor|cannot|without|no|or|recommendation to) ask/)
        printf "%d\tasks the operator or user without naming AskUserQuestion, the question tool, or the caller\n", hit
      para = ""; hit = 0
    }
    /^```/ { fence = !fence; next }
    fence { next }
    /^[[:space:]]*$/ { flush(); next }
    {
      para = para " " $0
      if (!hit && tolower($0) ~ /(^|[^a-z])(ask|confirm with|check with|prompt)(s|ing)? (the )?(operator|user)([^a-z]|$)/) hit = FNR
    }
    END { flush() }
  ' "$1"
}
while IFS= read -r f; do
  case "$f" in *.md) ;; *) continue ;; esac
  case "$f" in "$claude_tree"/*) ;; *) continue ;; esac
  while IFS=$'\t' read -r line msg; do
    fail ask "$f" "$line" "$msg"
  done < <(ask_misses "$f")
done < <(corpus_files)

if [ "$failed" -ne 0 ]; then
  echo "" >&2
  echo "crossref-check FAILED. Rename the reference to what exists now, or" >&2
  echo "restore the target; a renamed path is correct only inside" >&2
  echo "src/user/docket/config/changelogs/." >&2
  exit 1
fi

echo "crossref-check: ok ($(corpus_files | wc -l | tr -d ' ') files)"
