#!/usr/bin/env bash
#
# secret-scan — refuse a change that adds a credential to the tree.
#
# Wired as the `secret-scan` gate on `implement`, `implement-test-infra` and
# `fix` (src/user/docket/config/workflows/standard-change.toml). Without it, a
# committed credential is caught only by a judge who happens to read that hunk —
# a reviewer's attention standing in for a mechanical check.
#
# Scope is the working tree's own ADDED lines: a gate runs while a step holds
# the tree, so the question is "did this step add a secret". A secret already in
# the file is not this step's doing, and failing on it would make the gate
# unclearable for every later step that touches the file.
#
# CI has no staged or unstaged state to read — a checked-out pull request is a
# clean tree, and the change under review lives only in the COMMITTED diff
# between the PR's base and its head. So this script also accepts an optional
# base-ref argument: with one, "added" means an added line in ANY commit between
# the base and HEAD (a credential added then removed inside the same PR still
# trips this, deliberately — see collect() below); without one, behavior is the
# working-tree scan the write gates use.
#
# CALLED WITH NO ARGUMENT vs. CALLED WITH AN EMPTY ONE are different things, and
# `${1:-}` cannot tell them apart — both read as "". A CI caller that passes an
# interpolated GitHub Actions expression means "scan this committed diff"; if
# that expression ever resolves empty (a trigger with no PR base —
# merge_group, workflow_dispatch, a future widening of `on:` in
# .github/workflows/vorpal.yaml), silently falling back to the working-tree scan
# would pass a clean CI checkout having inspected nothing. So the check below is
# on `$#`, the argument COUNT, not the value: one argument, even an empty one,
# commits to CI mode and fails closed rather than downgrading.
#
# KNOWN LIMIT: base-ref mode diffs against the passed ref directly rather than an
# explicit `git merge-base`. `git log A..B` already anchors at the merge-base for
# an ordinary PR (A is an ancestor of B), so this only widens if the checked-out
# ref diverges from the PR's own history — which is what a stale `base.sha` on a
# rebased base branch would do. INFERRED risk, not reproduced against a real run.

set -euo pipefail

# ANCHORED TO THIS SCRIPT'S OWN REPOSITORY, not to the caller's cwd. The engine
# sets cwd to the repo root, but a hand-run from a subdirectory or from another
# checkout must not silently scan a different tree — a gate that reports on the
# wrong working tree is worse than one that refuses. Resolving the toplevel with
# git rather than counting `../..` also survives the file being moved deeper.
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
if ! repo_root="$(git -C "$script_dir" rev-parse --show-toplevel 2>/dev/null)"; then
  echo "secret-scan FAILED: $script_dir is not inside a git repository, so" >&2
  echo "nothing can be scanned." >&2
  exit 1
fi
cd "$repo_root"

if [ "$#" -gt 0 ]; then
  BASE_REF="$1"
  if [ -z "$BASE_REF" ]; then
    echo "secret-scan FAILED: a base-ref argument was passed but empty; refusing" >&2
    echo "to fall back to the working-tree scan, which would pass a clean CI" >&2
    echo "checkout having scanned nothing." >&2
    exit 1
  fi
else
  BASE_REF=""
fi

# High-signal shapes only. A pattern that fires on ordinary code trains people to
# route around the gate, so the bar is that a true positive is far likelier than
# a false one. That bar is why no pattern here matches a bare 40-character
# base64 blob (an AWS secret access key's shape): this tree carries 142 SHA-256
# digests in Vorpal.lock and a full cargo checksum set, and such a pattern would
# fire on those on every run.
#
# `github_pat_` is separate from `gh[pousr]_`: fine-grained PATs (2022 onward)
# use a different prefix entirely, so a list claiming GitHub coverage without it
# has a gap in its OWN stated scope rather than a deliberate scope choice.
#
# The last two are this repository's own secret systems rather than the upstream
# list's: Doppler service tokens and 1Password service-account tokens
# (docs/spec/security.md §3 — Doppler injects runtime secrets through the `s`
# alias, 1Password holds the vault and the signing agent). Both are prefixed
# shapes, so they cost nothing in false positives. The PEM header already covers
# an exported SSH signing key.
PATTERNS='AKIA[0-9A-Z]{16}
gh[pousr]_[A-Za-z0-9]{36,}
github_pat_[A-Za-z0-9_]{40,}
xox[abprs]-[0-9A-Za-z-]{10,}
sk-ant-[A-Za-z0-9_-]{20,}
AIza[0-9A-Za-z_-]{35}
-----BEGIN [A-Z ]*PRIVATE KEY-----
dop_v1_[A-Za-z0-9]{40,}
ops_eyJ[A-Za-z0-9_-]{20,}'

# Added lines, tracked and untracked. Untracked matters because a brand-new file
# is exactly where a credential lands and `git diff` cannot see one.
#
# `-z` and `read -d ''` are load-bearing, not style. Plain `git ls-files` QUOTES
# a name containing a tab, newline, or non-ASCII byte, and the quoted form does
# not name a real file — so the file is NEVER SCANNED and a credential inside it
# passes silently. Null-delimited output is unambiguous and needs no unquoting.
#
# `--exclude-standard` is also load-bearing here: without it the enumeration
# walks `target/` (gitignored, hundreds of megabytes of build output) on every
# run, which makes the gate slow enough to be routed around.
collect() {
  # `|| true` here is scoped to GREP ALONE, which exits 1 on "no matching lines"
  # — an ordinary outcome, not an error. A git failure still propagates.
  if [ -n "$BASE_REF" ]; then
    # CI mode: the change under review is the committed diff, not the working
    # tree — a checked-out PR has nothing staged or unstaged to find.
    #
    # `git log -p A..B`, NOT `git diff A...B`. A two-tree diff compares only the
    # base and head SNAPSHOTS, so a credential added in one commit and removed by
    # a later commit of the same PR is invisible to it — the two trees never
    # differ on that line. It is still a leak: it is in the reflog, in any
    # fetched copy, and in GitHub's API. Walking each commit's own patch catches
    # it. `..`, not `...`: for `git log` (unlike `git diff`), `A...B` is the
    # SYMMETRIC difference, while `A..B` is "commits new to this branch", which
    # is the question here.
    #
    # `--diff-merges=first-parent` IS LOAD-BEARING. `git log -p` defaults to
    # `--diff-merges=off`, so a MERGE COMMIT contributes no patch at all — and a
    # credential written during conflict resolution exists only in the merge
    # commit, in neither parent. It is in the merged tree and the scan never saw
    # it. This matters most on `pull_request`, where the checked-out HEAD IS
    # GitHub's synthetic merge commit. `first-parent`, not `remerge` or
    # `separate`: it shows everything the merge brought INTO the branch under
    # review, which is exactly the set that ends up in the merged tree.
    git log --unified=0 -p --diff-merges=first-parent "$BASE_REF"..HEAD -- . |
      { grep '^+' | grep -v '^+++' || true; }
    return
  fi
  # THREE sources, because a change hides in any of them. STAGED IS THE ONE THAT
  # MATTERS MOST: this gate runs on `implement`, before any commit, so an
  # executor that stages its work as it goes is ordinary — and a staged file is
  # absent from BOTH a bare working-tree diff and the untracked enumeration. The
  # secret would fall straight through the gap between them.
  git diff --cached --unified=0 -- . | { grep '^+' | grep -v '^+++' || true; }
  git diff --unified=0 -- . | { grep '^+' | grep -v '^+++' || true; }
  while IFS= read -r -d '' f; do
    # `./` rather than `--`: BSD sed (macOS, the only platform this repo builds
    # for) does not accept `--` as an end-of-options marker. The prefix keeps a
    # name beginning with `-` from parsing as a flag.
    [ -f "$f" ] && sed 's/^/+/' "./$f"
  done < <(git ls-files --others --exclude-standard -z)
}

# NO BLANKET `|| true`. That turns every collection failure — an aborted
# enumeration, a wrong tree state, a git that refused — into an empty result,
# which the emptiness check below then reports as "clean". A scanner that cannot
# collect its input must FAIL, not pass.
if ! added=$(collect); then
  echo "secret-scan FAILED: could not collect the change set; nothing was scanned." >&2
  exit 1
fi

if [ -z "$added" ]; then
  echo "secret-scan: no added lines to scan"
  exit 0
fi

# The matching line is never printed: it would land in the gate's recorded
# verdict, the event log, and every transcript quoting them — the gate would
# become the leak. The count is enough to go looking.
if hits=$(printf '%s\n' "$added" | grep -cE "$PATTERNS") && [ "$hits" -gt 0 ]; then
  echo "secret-scan FAILED: $hits added line(s) match a credential pattern." >&2
  echo "Remove it and re-run. If it is a fixture, make it unmistakably fake." >&2
  exit 1
fi

echo "secret-scan: clean"
