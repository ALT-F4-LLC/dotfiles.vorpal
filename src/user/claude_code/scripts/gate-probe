#!/usr/bin/env bash
#
# gate-probe — the conduct skill's completion-gate probe, as one run.
#
# Why: every conductor must clear the same probe before its first dispatch —
# run EVERY completion gate this repo's trust roster carries, once, against a
# throwaway worktree of clean HEAD, so a gate that fails on clean HEAD is
# surfaced to the operator ONCE instead of being rediscovered as a parked step
# per issue. The rule was written twice in the skill and narrowed anyway: one
# resume ran `make format` alone and skipped build, tests and four more,
# because the remaining rows "looked like" vote/verify/action rows and the
# probe lived in prose, where the roster is a judgment call. It is not a
# judgment call. The roster is whatever `docket trust list` returns, and this
# script runs all of it. There is no seam here for "these gates cannot matter
# for the rows I expect": the script does not know what rows you expect and
# neither, reliably, do you — `next` is the engine's answer, and a vote's
# `on_fail`, an `--as retry` or a fix batch puts a write-class step in front of
# you one dispatch later.
#
# What it does, in order:
#
#   1. resolves the repo toplevel and the trust roster (`docket trust list
#      --json=v2` — a read verb; it writes nothing);
#   2. registers ONE throwaway worktree of clean HEAD at a literal path under
#      the scratch base, printed before anything runs;
#   3. runs EVERY roster entry in that worktree, each with its own log,
#      capturing the command's OWN exit status (`cmd > log 2>&1; echo $?` —
#      never `$PIPESTATUS`, which is bash-only and has been observed printing
#      empty under zsh, and never the exit of something downstream of a pipe);
#   4. prints one verdict line per gate:
#
#          OK|FAIL <name> exit=<n> log=<path>            [STUB]
#
#      Nothing short-circuits: a failing gate does not stop the ones after it,
#      because the point is ONE report covering the whole roster, not the first
#      thing that broke. A STUB entry is a placeholder trusted under a real
#      gate's name (`docket trust add --stub`); its pass is hollow and the
#      marker says so, but it is run and counted like any other.
#   5. removes the worktree unconditionally, on success, on failure, and on an
#      interrupt (EXIT/INT/TERM trap), then verifies the removal against `git
#      worktree list` and says so if anything is left behind. The LOGS survive
#      the worktree so the failures can be read after the fact.
#
# Usage:  gate-probe [RUN-N]
#
#   Run it from the repository root of the run's repo, before the first
#   dispatch. RUN-N is optional and used only to label the scratch directory;
#   unlike attach-probe there is no per-run check here, so omitting it skips
#   nothing and there is no exit 2.
#
#   GATE_PROBE_DIR overrides the scratch base (default $TMPDIR, else /tmp). The
#   base is resolved ONCE, here, and every later path is derived from that one
#   resolution — the reason the skill's by-hand version had to spell the path
#   out literally (a `$TMPDIR` observed resolving to two different directories
#   across consecutive `Bash` calls) does not apply to a path a single process
#   creates, uses and removes.
#
# Notes:
#   - Each gate runs with stdin from /dev/null. A gate that reads stdin (an
#     engine action fed a JSON bundle, say) then fails fast instead of hanging
#     the probe forever, and that failure is a real finding about running it as
#     a gate.
#   - Per-entry `--timeout` from the trust roster is NOT enforced here; the
#     engine enforces it when it runs the gate for real. A genuinely hung gate
#     hangs this probe, which is visible, unlike a gate silently skipped.
#   - A gate that fails on clean HEAD is not caused by the run's changes. It is
#     commonly ENVIRONMENTAL (an untracked toolchain that never materializes in
#     a fresh worktree, a sandbox denial, a network block) but possibly a
#     genuine pre-existing defect. Either way it goes to the operator once,
#     before any step pays for it. This script tells you WHICH verdict you
#     have; the skill's prose says what to do about it.
#
# Exit codes:
#   0  every gate in the roster passed.
#   1  at least one gate FAILed, or the probe could not run (no roster, no
#      worktree, not a git work tree). Either way: report to the operator
#      before the first dispatch.
#
set -uo pipefail

RUN="${1-}"
if [ "$RUN" = "-h" ] || [ "$RUN" = "--help" ]; then
    sed -n '2,/^set -uo/p' "$0" | sed 's/^# \{0,1\}//; $d'
    exit 0
fi

detail() { sed 's/^/                 /'; }

# ---- 0. seat ---------------------------------------------------------------
top=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -z "$top" ]; then
    echo "gate-probe: cwd is not inside a git work tree: $(pwd -P)" >&2
    echo "gate-probe: nothing probed." >&2
    exit 1
fi
top=$(cd "$top" && pwd -P)

if ! command -v docket >/dev/null 2>&1; then
    echo "gate-probe: docket is not on PATH — the roster is unreadable, nothing probed." >&2
    exit 1
fi

# ---- 1. roster -------------------------------------------------------------
# The roster is `docket trust list` for THIS repo: the entries a workflow's
# gate names resolve to. Argv some earlier step happened to record is a subset
# of it, never the list, so nothing else is consulted.
roster_json=$(docket trust list --json=v2 2>&1)
roster_rc=$?
if [ "$roster_rc" -ne 0 ] || [ "${roster_json#*'"ok":false'}" != "$roster_json" ]; then
    echo "gate-probe: \`docket trust list\` failed — nothing probed." >&2
    printf '%s\n' "$roster_json" >&2
    exit 1
fi

# One record per entry, \x1e-terminated; fields \x1f-separated:
#   name \x1f stub \x1f argv0 \x1f argv1 \x1f ...
roster=$(printf '%s' "$roster_json" | python3 -c '
import json, sys
d = json.load(sys.stdin)
for it in (d.get("data") or {}).get("items") or []:
    row = [it.get("name") or "?", "stub" if it.get("stub") else ""]
    row += [str(a) for a in (it.get("argv") or [])]
    sys.stdout.write("\x1f".join(row) + "\x1e")
' 2>&1)
if [ $? -ne 0 ]; then
    echo "gate-probe: could not parse the trust roster — nothing probed." >&2
    printf '%s\n' "$roster" >&2
    exit 1
fi
if [ -z "$roster" ]; then
    echo "gate-probe: the trust roster for $top is EMPTY — no gate was probed." >&2
    echo "gate-probe: that is a finding, not a pass. Report it before dispatching." >&2
    exit 1
fi

# ---- 2. scratch worktree of clean HEAD -------------------------------------
base="${GATE_PROBE_DIR:-${TMPDIR:-/tmp}}"
mkdir -p "$base" 2>/dev/null
base=$(cd "$base" 2>/dev/null && pwd -P) || {
    echo "gate-probe: scratch base is not usable: ${GATE_PROBE_DIR:-${TMPDIR:-/tmp}}" >&2
    exit 1
}
scratch="$base/gate-probe.${RUN:-norun}.$$"
WT="$scratch/wt"
LOGS="$scratch/logs"
mkdir -p "$LOGS" || exit 1

# Unconditional: success, failure, or interrupt. A probe worktree is a
# registration in the SHARED repo that outlives the shell that made it, sits at
# a detached head with no branch, and is therefore invisible to any
# branch-derived close sweep — the path is the only thing that puts it back.
# So the trap owns it, not the happy path.
cleanup() {
    if [ -n "${WT_MADE:-}" ]; then
        git -C "$top" worktree remove --force "$WT" >/dev/null 2>&1 ||
            rm -rf "$WT" >/dev/null 2>&1
        git -C "$top" worktree prune >/dev/null 2>&1
        if git -C "$top" worktree list --porcelain 2>/dev/null |
            grep -qxF "worktree $WT"; then
            echo "gate-probe: LEFTOVER worktree still registered: $WT" >&2
            echo "gate-probe: remove it by hand — \`git -C $top worktree remove --force $WT\`" >&2
        fi
    fi
}
# A signal must clean up AND STOP. Trapping INT/TERM to `cleanup` alone was
# measured doing the wrong thing: bash defers the handler until the running
# gate returns, runs it, and then RESUMES the loop — so the worktree was
# removed out from under the gates that had not run yet and every one of them
# reported FAIL with a `cd: No such file or directory`, a report that looks
# like nine broken gates and is really one interrupted probe.
on_signal() {
    trap - EXIT
    cleanup
    echo >&2
    echo "gate-probe: interrupted — worktree removed, roster NOT fully probed." >&2
    exit 130
}
trap cleanup EXIT
trap on_signal INT TERM

head_sha=$(git -C "$top" rev-parse HEAD 2>/dev/null)
echo "gate-probe: repo      $top"
echo "gate-probe: HEAD      ${head_sha:-unknown}"
echo "gate-probe: worktree  $WT"
echo "gate-probe: logs      $LOGS"
echo

if ! wt_out=$(git -C "$top" worktree add --detach "$WT" HEAD 2>&1); then
    echo "gate-probe: could not create the scratch worktree — nothing probed." >&2
    printf '%s\n' "$wt_out" >&2
    exit 1
fi
WT_MADE=1

# ---- 3. run EVERY entry ----------------------------------------------------
gates=0
failed=0
failed_names=''
while IFS= read -r -d $'\x1e' rec; do
    [ -n "$rec" ] || continue
    IFS=$'\x1f' read -r -a f <<<"$rec"
    name=${f[0]}
    stub=${f[1]}
    set -- "${f[@]:2}"
    if [ "$#" -eq 0 ]; then
        gates=$((gates + 1))
        failed=$((failed + 1))
        failed_names="$failed_names $name"
        printf '%-4s %-22s exit=%-4s log=%s%s\n' FAIL "$name" '-' '-' \
            "$([ -n "$stub" ] && echo ' STUB')"
        echo "roster entry has no argv — nothing to run" | detail
        continue
    fi

    log="$LOGS/$name.log"
    gates=$((gates + 1))
    # The command's OWN status, from a plain redirect. No pipe stands between
    # the gate and `$?`, so there is no $PIPESTATUS to get wrong and nothing
    # downstream whose exit could be reported as the gate's.
    (cd "$WT" && "$@") >"$log" 2>&1 </dev/null
    rc=$?

    if [ "$rc" -eq 0 ]; then
        verdict=OK
    else
        verdict=FAIL
        failed=$((failed + 1))
        failed_names="$failed_names $name"
    fi
    printf '%-4s %-22s exit=%-4s log=%s%s\n' "$verdict" "$name" "$rc" "$log" \
        "$([ -n "$stub" ] && echo ' STUB')"
    if [ "$verdict" = FAIL ]; then
        tail -n 5 "$log" 2>/dev/null | detail
    fi
done <<<"$roster"

# ---- verdict ---------------------------------------------------------------
echo
if [ "$failed" -ne 0 ]; then
    echo "gate-probe: $gates gate(s) run, $failed FAILED —$failed_names"
    echo "gate-probe: these fail on CLEAN HEAD, so no step's changes caused them."
    echo "gate-probe: (a roster entry that is an engine ACTION — one the engine feeds a JSON"
    echo "gate-probe: bundle on stdin, e.g. doc-record — fails here by construction: this probe"
    echo "gate-probe: gives every entry /dev/null. That is still a disposition to record, once.)"
    echo "gate-probe: surface them to the operator ONCE and record the disposition"
    echo "gate-probe: (fix the environment, a named override, or FIX-FIRST) before dispatching."
    exit 1
fi
echo "gate-probe: $gates gate(s) run, all passed on clean HEAD."
exit 0
